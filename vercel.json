{
  "version": 2,
  "builds": [
    {
      "src": "setup.html",
      "use": "@vercel/static"
    },
    {
      "src": "aws-backend-cloudformation.yml",
      "use": "@vercel/static"
    },
    {
      "src": "oracle-stockkar-template.zip",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/",
      "dest": "/setup.html"
    },
    {
      "src": "/setup",
      "dest": "/setup.html"
    },
    {
      "src": "/setup.html",
      "dest": "/setup.html"
    },
    {
      "src": "/aws-backend-cloudformation.yml",
      "dest": "/aws-backend-cloudformation.yml"
    },
    {
      "src": "/oracle-stockkar-template.zip",
      "dest": "/oracle-stockkar-template.zip"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
